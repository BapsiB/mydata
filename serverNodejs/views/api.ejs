<!DOCTYPE html>
<html>

<head>
    <title>API Interface</title>
    <script>

        async function sendData(event) {
            event.preventDefault();
            const question = document.getElementById('question').value;
            const jsonData = document.getElementById('jsonData').value;
            document.getElementById('response').innerText = 'Loading...';

            const response = await fetch("<%= apiPath %>" + '/api', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question, jsonData })
            });
            const data = await response.json();
            if (data.message == "ok") {

                const response2 = await fetch("<%= apiPath %>" + '/addUserQuestion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question })
                });

                document.getElementById('response').innerText = '';

                const eventSource = new EventSource("<%= apiPath %>" + '/stream');
                eventSource.onmessage = function (event) {
                    const data = JSON.parse(event.data);
                    const outputDiv = document.getElementById('response');
                    outputDiv.innerHTML += `${data.message}`; // Append new messages
                };
                eventSource.onerror = function (error) {
                    console.log('EventSource failed:', error);
                    eventSource.close();
                };
            }
            else {
                document.getElementById('response').innerText = 'error';
            }
        }

    </script>
</head>

<body>
    <form onsubmit="sendData(event)">
        <label for="question">Question:</label><br>
        <input type="text" id="question" name="question" style="
            width: 50%;
            height: 50px;
        "><br>
        <label for="jsonData">CSV Data:</label><br>
        <textarea id="jsonData" name="jsonData" rows="10" cols="50" style="
            width: 50%;
            height: 400px;
        " required></textarea>
        <br><br>
        <input type="submit" value="Submit">
    </form>
    <p id="response" style="
        width: 50%;
        font-size: large;
    "></p>
</body>

</html>