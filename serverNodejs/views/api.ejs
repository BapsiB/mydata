<!DOCTYPE html>
<html>

<head>
    <title>API Interface</title>
    <script src="./api.js"></script>
</head>

<body>
    <form onsubmit="sendData(event, '<%= apiPath %>')">
        <label for="question">Question:</label><br>
        <input type="text" id="question" name="question" style="
            width: 50%;
            height: 50px;
        "><br>
        <label for="jsonData">CSV Data:</label><br>
        <textarea id="jsonData" name="jsonData" rows="10" cols="50" style="
            width: 50%;
            height: 400px;
        " required></textarea>
        <br><br>
        <input type="submit" value="Submit">
    </form>
    <p id="response" style="
        width: 50%;
        font-size: large;
    "></p>
</body>

</html>